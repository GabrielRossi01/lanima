# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Supabase desde a fase 2; IA na fase 6. Para o Supabase local, `npx supabase status` mostra os valores.

# Supabase (Project Settings → API Keys). A "publishable key" (sb_publishable_…) substitui a antiga
# "anon key"; as duas funcionam aqui. É pública: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (a "secret key", sb_secret_…, ou a antiga service_role). Nunca use prefixo NEXT_PUBLIC_.
# A fase 2 não usa; o E2E lê a do Supabase local sozinho.
SUPABASE_SECRET_KEY=
# "true" mostra o botão "Entrar com o Google" (configure o provedor antes; veja o README).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# IA: só planos gratuitos, sem cartão (ver README).
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Os nomes dos modelos mudam com frequência: confira os gratuitos atuais na documentação de cada provedor.
AI_PRIMARY_PROVIDER=google
AI_PRIMARY_MODEL=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=
# Limite diário por usuária.
AI_DAILY_SUMMARIES=10
AI_DAILY_QUESTION_RUNS=15
