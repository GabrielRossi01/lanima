# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Supabase desde a fase 2; IA na fase 6. Para o Supabase local, `npx supabase status` mostra os valores.

# Supabase (Project Settings → API Keys). A "publishable key" (sb_publishable_…) substitui a antiga
# "anon key"; as duas funcionam aqui. É pública: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (a "secret key", sb_secret_…, ou a antiga service_role). Nunca use prefixo NEXT_PUBLIC_.
# A fase 2 não usa; o E2E lê a do Supabase local sozinho.
SUPABASE_SECRET_KEY=
# Botões de login social, entre google e notion, separados por vírgula ("google,notion").
# Só os que já estão ativos no Supabase (veja o README). Vazio: só e-mail.
NEXT_PUBLIC_AUTH_PROVIDERS=

# IA (fase 6): só planos gratuitos, sem cartão (ver README). As chaves ficam só no servidor.
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Os nomes dos modelos mudam com frequência: confira os gratuitos atuais na documentação de cada provedor.
# Principal: Gemini Flash-Lite (mais pedidos por dia no plano gratuito). Reserva: Groq, só para pedidos pequenos.
AI_PRIMARY_PROVIDER=google
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=openai/gpt-oss-120b
# Maior pedido que a reserva aceita (entrada + saída, em tokens): o plano gratuito da Groq tem poucos tokens por minuto.
AI_FALLBACK_MAX_TOKENS=6000
# Acima disso (em tokens), o resumo é feito por partes e depois juntado.
AI_MAX_INPUT_TOKENS=120000
# Os limites por dia (por pessoa e do app todo) ficam no banco, na tabela ai_limits (ver README).
