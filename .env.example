# Copie para .env.local e preencha. Nunca faça commit do .env.local.
# Fase 1 não usa nenhuma destas variáveis; elas entram nas fases 2 (Supabase) e 6 (IA).

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# IA: só planos gratuitos, sem cartão (ver README).
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
# Os nomes dos modelos mudam com frequência: confira os gratuitos atuais na documentação de cada provedor.
AI_PRIMARY_PROVIDER=google
AI_PRIMARY_MODEL=
AI_FALLBACK_PROVIDER=groq
AI_FALLBACK_MODEL=
# Limite diário por usuária.
AI_DAILY_SUMMARIES=10
AI_DAILY_QUESTION_RUNS=15
